#!/usr/bin/ucode
// SPDX-License-Identifier: Apache-2.0
// Copyright 2026 VolanticSystems
//
// appflowd — aggregate Netify Agent (netifyd) DPI flow events into live
// per-application / per-device / per-category traffic statistics and serve
// them over ubus.  See docs/DESIGN.md; section references below point there.
//
// Data path (§3):
//   netifyd  --unix stream, length-framed JSON-->  appflowd  --ubus-->  LuCI
//
// Everything that counts a byte goes through account() (§7.1), which is the
// single seam historical accounting will tap into.

import * as fs from "fs";
import * as uloop from "uloop";
import * as ubus from "ubus";
import * as socket from "socket";
import { cursor } from "uci";

/* ------------------------------------------------------------------ *
 * Constants — the memory bounds of §3.3 live here.  Every table in the
 * daemon is capped; nothing grows with uptime or traffic volume.
 * ------------------------------------------------------------------ */

const NAME = "appflowd";
const VERSION = "1.0";

const RX_CHUNK = 16384;          // bytes per recv()
const RX_MAX = 262144;           // partial-line buffer ceiling; beyond this the
                                 // peer is not speaking our protocol -> resync
const RX_DRAIN_MAX = 64;         // recv() calls per readable event (fairness)

const AGG_MAX = 384;             // max aggregates per class (apps/devices/cats)
const APP_DEV_MAX = 64;          // devices tracked per application (LRU)
const APP_HOST_MAX = 16;         // hostnames tracked per application (LRU)
const NAME_MAX = 8192;           // id->tag map ceiling (nDPI catalogue is ~2.5k)
const TAG_MAX = 64;              // max stored length of any detection tag
const UNKNOWN_TYPE_MAX = 16;     // distinct unhandled event types remembered
const EVENT_TYPE_MAX = 24;       // distinct event types counted in status
const FLOWS_REPLY_MAX = 200;     // hard ceiling for the flows[] ubus reply
const LIST_REPLY_MAX = 200;      // hard ceiling for apps[]/devices[] replies

// Trailing-hour time series (§7.2 buckets, GL-parity `stats` method):
// 12 slots x 5 minutes.  Slot numbers are absolute (epoch_ms / SERIES_MS), so
// a slot is self-describing and stale slots need no eager clearing.
const SERIES_SLOTS = 12;
const SERIES_MS = 300000;
// Per (app x device) we only need trailing-hour *totals*, not a series, so a
// coarser 4 x 15 min ring is used: same code path, quarter the memory.  The
// window it reports is therefore 45-60 minutes rather than exactly 60.
const DEVSER_SLOTS = 4;
const DEVSER_MS = 900000;

const PRUNE_MS = 15000;          // idle-flow / aggregate sweep interval
const LEASE_TTL_MS = 30000;      // DHCP lease file re-read throttle (§4)
const LOG_REPEAT_MS = 60000;     // identical-message log suppression window
const RECONNECT_MIN_MS = 1000;
const RECONNECT_MAX_MS = 30000;

// netifyd 4.4 keeps its category list under /etc/netify.d; 5.x moved it to
// /etc/netifyd, same format. Without the second path every category on 5.x
// read "unclassified" (Docker test, 2026-10-12).
const CATEGORY_FILES = [ "/etc/netify.d/netify-categories.json",
                         "/etc/netifyd/netify-categories.json" ];

// netifyd 5.x moved the JSON export out of the agent into the
// netify-sink-socket plugin, which listens here. The old path still exists on
// 5.x but is a different socket that accepts a connection and sends nothing,
// so appflowd looked connected and idle while receiving nothing at all. When
// the configured path is the 4.4 default and the 5.x socket exists, use the
// 5.x one; an explicitly configured path is always used as given.
const LEGACY_SOCKET = "/var/run/netifyd/netifyd.sock";
const SINK_SOCKET = "/var/run/netifyd/netify-sink.sock";
const SILENT_MS = 60000;         // connected with no events this long: warn
const LEASE_FILE = "/tmp/dhcp.leases";
const STATUS_FILE = "/var/run/netifyd/status.json";
const CONNTRACK_FILE = "/proc/net/nf_conntrack";

const CT_TTL_MS = 2000;          // reuse one conntrack snapshot this long (3.2)
const CT_RETRY_MS = 60000;       // re-probe an unreadable conntrack this often
const CT_FORCE_MIN_MS = 250;     // floor between miss-driven refreshes (3.2)
const CT_MAX = 8192;             // entries kept from one snapshot (memory bound, 3.3)

const CFG_DEFAULTS = {
	socket_path: "/var/run/netifyd/netifyd.sock",
	conntrack_path: "/proc/net/nf_conntrack",
	flow_max: 4096,
	rate_window: 30,
	top_n: 10,
	idle_timeout: 300,
	ai_breakout: 1
};

// Conntrack snapshot used to resolve NAT twins (3.2).  `map` is keyed on the
// REPLY tuple, which is the view netifyd's external capture reports, and holds
// true when that flow was source-translated.  `avail` is null until first
// probed, then true/false; false is re-probed every CT_RETRY_MS so a conntrack
// module loaded after us is picked up without needing a restart.
let conntrack = { at: 0, probed: 0, avail: null, map: {}, entries: 0 };

// Any event type matching this and carrying flow.digest finalises a flow.
// netifyd 4.4.7 emits "flow_purge"; the regex keeps a renamed or additional
// event working without a code change (the dispatcher below is data-driven).
const PURGE_RE = regexp("(purge|expire|delete|remove|terminat|close)", "i");

/* ------------------------------------------------------------------ *
 * State
 * ------------------------------------------------------------------ */

let cfg = {};

let sock = null;                 // socket handle to netifyd
let sock_fd = null;              // uloop fd handle
let rxbuf = "";                  // partial line carry-over
let connected = false;
let ever_connected = false;      // distinguishes the first connect from reconnects
let hello_logged = false;        // agent_hello logged on this connection
let active_path = null;          // the socket actually connected to
let connected_ms = 0;            // when this connection was made
let silent = false;              // connected, but nothing has arrived
let backoff_ms = RECONNECT_MIN_MS;
let retry_timer = null;

let flows = {};                  // digest -> flow record
let nflows = 0;
// True once any internal (LAN-bridge) capture has been seen.  The single-count
// shadow rule only trusts "the internal capture already counted this" when
// internal capture is actually active; on an external-only netifyd setup it
// must not shadow client flows or the dashboard would read near-zero.
let saw_internal = false;

let apps = {}, devs = {}, cats = {};
let totals = null;               // aggregate covering everything

let names = { app: {}, proto: {} };      // id -> netifyd tag (definitions event)
let catnames = { app: {}, proto: {} };   // id -> category tag (categories file)

let leases = { at: 0, mtime: -1, by_mac: {}, by_ip: {} };
let router = { macs: {}, ips: {} };      // this router's own L2/L3 identities
let agent = { version: null, uptime: 0, flow_count: 0, ts: 0 };

let stats = {
	events: 0, frames: 0, malformed: 0, unknown: 0, unknown_types: {},
	by_type: {}, reconnects: 0, connect_fail: 0, purges: 0,
	flows_seen: 0, flows_late: 0, flows_pruned: 0, flows_dropped: 0,
	// Flows relabelled by the AI hostname table. Observable so a test can
	// assert the feature fired rather than inferring it from a label.
	ai_labeled: 0,
	// Flows evicted because the table was AT ITS CAP, as opposed to evicted for
	// going idle.  The two used to share flows_pruned, where cap pressure was
	// invisible underneath ordinary housekeeping.
	//
	// This exists because flows_dropped, which reads like the counter for
	// "flows we could not keep", CANNOT BE MOVED BY ANY INPUT.  flow_new()
	// increments it only if the table is still full after prune(now, true), and
	// that prune unconditionally sheds int(flow_max/10)+1 entries, so it always
	// frees space and the fall-through never happens.  Measured 2026-08-26 by
	// tests/protocol-suite.sh: 200 distinct digests against flow_max=64 gave
	// tracked=60 pruned=143 dropped=0.  An operator reading `dropped: 0`
	// concluded nothing was being lost while flows were being shed constantly.
	// Same shape as aggs_refused below, and found the same way.
	//
	// flows_dropped is kept as the genuine last-resort backstop it always was.
	// flows_shed is the number an operator should actually watch.
	flows_shed: 0,
	shadowed: 0, aggs_pruned: 0, rx_bytes: 0, resyncs: 0, sweeps: 0,
	// Times an aggregate table was full of LIVE entries and a new key was
	// therefore not tracked at all.  Distinct from aggs_pruned, which counts
	// evictions of idle entries and is normal housekeeping.  A non-zero value
	// here means the dashboard is silently incomplete.
	aggs_refused: 0,
	no_total: 0, last_event_ms: 0, last_reset_ms: 0,
	// NAT twin resolution outcomes (3.2): twins shadowed on conntrack evidence,
	// router-originated flows kept, and flows conntrack could not decide, which
	// are shadowed on the safe default.
	ct_twins: 0, ct_local: 0, ct_unresolved: 0,
	// Purge-only flows rescued (see flow_update).  Expected to stay 0 on
	// netifyd 4.4.7; a non-zero value means that assumption has changed.
	purge_only: 0,
	// Byte conservation (§2.5): reported == attributed + shadowed, or
	// something is leaking.  Both silent byte-loss defects found in this
	// daemon would have been visible here from the start.
	bytes_reported: 0, bytes_attributed: 0, bytes_shadowed: 0
};

let start_ms = 0;
let start_mono = 0;
let log_seen = {};
// The published ubus object must stay referenced: dropping the last reference
// lets ucode collect it, which unregisters the object from ubus.
let ubus_obj = null;

// Forward declarations.  ucode binds an identifier at compile time: one that
// is still undeclared resolves to a global, while `function f()` further down
// declares a local, so the call would find null.  connect/schedule_reconnect
// are mutually recursive and prune() is used by the flow table above its own
// definition, so those four are declared here and assigned below.
let prune, connect, disconnect, schedule_reconnect;

/* ------------------------------------------------------------------ *
 * Small helpers
 * ------------------------------------------------------------------ */

function now_ms() {
	let c = clock();
	return c[0] * 1000 + int(c[1] / 1000000);
}

function mono_ms() {
	let c = clock(true);
	return c[0] * 1000 + int(c[1] / 1000000);
}

function num(v, def) {
	if (v == null)
		return def;
	let n = int(v);
	return (type(n) == "int") ? n : def;
}

function clampi(v, lo, hi) {
	return (v < lo) ? lo : ((v > hi) ? hi : v);
}

// procd feeds our stdout to logd as daemon.info and our stderr as daemon.err
// (see the init script), so route by severity and flush explicitly -- stdout
// is block buffered when it is a pipe.
function logmsg(level, fmt, ...args) {
	let out = (level == "error") ? fs.stderr : fs.stdout;
	out.write(sprintf("[%s] %s\n", level, sprintf(fmt, ...args)));
	out.flush();
}

// Log at most one identical message per LOG_REPEAT_MS.  Reconnect churn while
// netifyd is down must not turn into log spam.
function logonce(key, level, fmt, ...args) {
	let now = mono_ms();
	if (log_seen[key] && (now - log_seen[key]) < LOG_REPEAT_MS)
		return;
	if (length(log_seen) > 32)
		log_seen = {};
	log_seen[key] = now;
	logmsg(level, fmt, ...args);
}

/* ------------------------------------------------------------------ *
 * Configuration (uci: /etc/config/appflow)
 * ------------------------------------------------------------------ */

function cfg_load() {
	let s = {};
	try {
		s = cursor().get_all("appflow", "main") ?? {};
	} catch (e) {
		logmsg("warn", "uci: %s — using defaults", e);
	}

	/* User-supplied hostname mappings, from `config hostmap` sections.
	 *
	 * Each adds or OVERRIDES one entry in the built-in table, so this is both
	 * the way to teach appflow a service it does not know and the way to
	 * correct one it gets wrong. Consulted before the built-in table.
	 *
	 *     config hostmap
	 *             option suffix 'torproject.org'
	 *             option name 'Tor'
	 *             option category 'Privacy'
	 *             option strong '0'
	 *
	 * A malformed section is skipped and named in the log rather than
	 * silently ignored: a typo in a suffix produces a rule that matches
	 * nothing, which looks identical to the feature not working.
	 */
	let hostmap = {};
	let bad = 0;
	try {
		cursor().foreach("appflow", "hostmap", function(h) {
			let suf = lc(trim(h.suffix ?? ""));
			let nm  = trim(h.name ?? "");

			/* A suffix must contain a dot, or it can never match: the matcher
			 * rebuilds the last N labels of a hostname and compares, so a
			 * single label matches nothing. */
			if (!length(suf) || !length(nm) || index(suf, ".") < 0) {
				bad++;
				logmsg("warn", "hostmap: skipping entry with suffix %s name %s",
				       suf ?? "(empty)", nm ?? "(empty)");

				return;
			}

			hostmap[suf] = [ nm,
			                 length(trim(h.category ?? "")) ? trim(h.category) : "other",
			                 num(h.strong, 0) != 0 ];
		});
	} catch (e) {
		logmsg("warn", "hostmap: %s", e);
	}
	if (length(hostmap))
		logmsg("info", "hostmap: %d user entr%s loaded%s",
		       length(hostmap), length(hostmap) == 1 ? "y" : "ies",
		       bad ? sprintf(", %d skipped", bad) : "");

	cfg = {
		socket_path: length(s.socket_path ?? "") ? s.socket_path : CFG_DEFAULTS.socket_path,
		conntrack_path: length(s.conntrack_path ?? "") ? s.conntrack_path : CFG_DEFAULTS.conntrack_path,
		flow_max: clampi(num(s.flow_max, CFG_DEFAULTS.flow_max), 64, 65536),
		rate_window: clampi(num(s.rate_window, CFG_DEFAULTS.rate_window), 5, 600),
		top_n: clampi(num(s.top_n, CFG_DEFAULTS.top_n), 1, 100),
		idle_timeout: clampi(num(s.idle_timeout, CFG_DEFAULTS.idle_timeout), 15, 86400),
		// Absent means ON. A dashboard feature that defaults to off is a
		// feature nobody sees, and this one only ever relabels flows netifyd
		// had no answer for.
		ai_breakout: num(s.ai_breakout, CFG_DEFAULTS.ai_breakout) != 0,
		hostmap: hostmap
	};
	cfg.rate_ms = cfg.rate_window * 1000;
	cfg.idle_ms = cfg.idle_timeout * 1000;
}

/* ------------------------------------------------------------------ *
 * Time-bucketed accumulators (§7.2)
 *
 * A ring of `n` slots, each tagged with its absolute slot number.  Writes are
 * O(1) and self-invalidating: a slot whose tag is not in the trailing window
 * is simply not counted, so no eager rotation is needed for correctness.  The
 * periodic sweep below still clears stale slots so their bytes cannot be
 * resurrected by a clock step and so status output stays cheap.
 * ------------------------------------------------------------------ */

function ring_new(n) {
	let r = { s: [], d: [], u: [] };
	for (let i = 0; i < n; i++) {
		push(r.s, -1);
		push(r.d, 0);
		push(r.u, 0);
	}
	return r;
}

function ring_add(r, slot, n, up, down) {
	let i = slot % n;
	if (r.s[i] != slot) {
		r.s[i] = slot;
		r.d[i] = 0;
		r.u[i] = 0;
	}
	r.d[i] += down;
	r.u[i] += up;
}

function ring_total(r, slot, n) {
	let d = 0, u = 0;
	for (let i = 0; i < n; i++) {
		if (r.s[i] > (slot - n) && r.s[i] <= slot) {
			d += r.d[i];
			u += r.u[i];
		}
	}
	return [ d, u ];
}

function ring_series(r, slot, n, slot_ms) {
	let out = [];
	for (let k = n - 1; k >= 0; k--) {
		let s = slot - k, i = s % n, ok = (r.s[i] == s);
		push(out, {
			ts: s * slot_ms,
			download: ok ? r.d[i] : 0,
			upload: ok ? r.u[i] : 0
		});
	}
	return out;
}

function ring_sweep(r, slot, n) {
	for (let i = 0; i < n; i++)
		if (r.s[i] >= 0 && (r.s[i] <= (slot - n) || r.s[i] > slot)) {
			r.s[i] = -1;
			r.d[i] = 0;
			r.u[i] = 0;
		}
}

function ring_clear(r, n) {
	for (let i = 0; i < n; i++) {
		r.s[i] = -1;
		r.d[i] = 0;
		r.u[i] = 0;
	}
}

/* ------------------------------------------------------------------ *
 * Aggregates
 *
 * Shape is {cur, buckets} per §7.2: `cur` is the session accumulator plus a
 * two-bucket sliding window used for the live rate, `buckets` is the hour-long
 * time series.  History support (§7) extends `buckets`, nothing else.
 * ------------------------------------------------------------------ */

function agg_new(kind, key, name, now) {
	return {
		kind, key, name,
		cur: { up: 0, down: 0, flows: 0, first: now, last: 0 },
		// Sliding rate window: bytes land in the open bucket; when it ages past
		// rate_window it becomes the closed bucket and a fresh one opens.  The
		// reported rate spans closed+open, i.e. 1x-2x the window.  Chosen over
		// an EWMA because netifyd delivers flow_stats in ~15 s bursts: an EWMA
		// tuned tight enough to be live would oscillate between spike and zero,
		// while this integrates each burst over a known interval.  Cost is O(1)
		// memory and no per-second timer.
		rate: { t0: now, up: 0, down: 0, pdt: 0, pup: 0, pdown: 0 },
		buckets: ring_new(SERIES_SLOTS)
	};
}

function agg_roll(a, now) {
	let span = now - a.rate.t0;
	if (span >= cfg.rate_ms) {
		a.rate.pdt = span;
		a.rate.pup = a.rate.up;
		a.rate.pdown = a.rate.down;
		a.rate.t0 = now;
		a.rate.up = 0;
		a.rate.down = 0;
	}
}

// Pure: computes the rate WITHOUT rolling the window, so a read never mutates
// state.  Two clients polling at different intervals (or a second browser tab)
// must see identical numbers for identical traffic; the window is advanced only
// by agg_bump and housekeeping.  Rolls are applied virtually here.
function agg_rate(a, now) {
	let span = now - a.rate.t0;
	let pdt, pup, pdown, cspan, cup, cdown;
	if (span >= cfg.rate_ms) {          // window would have rolled
		pdt = span; pup = a.rate.up; pdown = a.rate.down;
		cspan = 0; cup = 0; cdown = 0;
	} else {
		pdt = a.rate.pdt; pup = a.rate.pup; pdown = a.rate.pdown;
		cspan = span; cup = a.rate.up; cdown = a.rate.down;
	}
	// Floor the denominator at one window so a single burst cannot be reported
	// as an impossibly high instantaneous rate.
	let denom = pdt + cspan;
	if (denom < cfg.rate_ms)
		denom = cfg.rate_ms;
	return [
		int((pup + cup) * 1000 / denom),
		int((pdown + cdown) * 1000 / denom)
	];
}

function agg_bump(a, up, down, now, slot) {
	agg_roll(a, now);
	a.cur.up += up;
	a.cur.down += down;
	a.cur.last = now;
	a.rate.up += up;
	a.rate.down += down;
	ring_add(a.buckets, slot, SERIES_SLOTS, up, down);
}

function agg_reset(a, now) {
	a.cur.up = 0;
	a.cur.down = 0;
	a.cur.first = now;
	a.cur.last = 0;
	a.rate = { t0: now, up: 0, down: 0, pdt: 0, pup: 0, pdown: 0 };
	ring_clear(a.buckets, SERIES_SLOTS);
}

// Evict the least recently active zero-flow aggregate when a class is full.
function agg_make(tbl, kind, key, name, now) {
	let a = tbl[key];
	if (a)
		return a;

	if (length(tbl) >= AGG_MAX) {
		let victim = null, oldest = now + 1;
		for (let k in tbl) {
			let c = tbl[k];
			if (c.cur.flows > 0)
				continue;
			if (c.cur.last < oldest) {
				oldest = c.cur.last;
				victim = k;
			}
		}
		if (victim == null) {
			// Every slot is backed by a live flow: refuse to grow (§3.3).
			// Bytes still land in the totals, so the summary stays truthful.
			// Counted, not just logged.  logonce() fires ONCE for the life of
			// the process, so without this an operator polling status sees
			// `devices: 384` and no sign that anything is being dropped -- the
			// table looks healthy precisely when it has stopped accepting the
			// device the user is looking for.  A security panel on 2026-08-25
			// converged on this table being fillable by a LAN attacker
			// (confirmed: six spoofed MACs produced six aggregates on
			// hardware).  Evicting live data is already refused above, which is
			// the right call; what was missing was any way to SEE the refusal.
			stats.aggs_refused++;
			logonce("aggfull", "warn", "%s table full (%d), not tracking %s",
			        kind, AGG_MAX, key);
			return null;
		}
		delete tbl[victim];
		stats.aggs_pruned++;
	}

	a = agg_new(kind, key, name, now);
	tbl[key] = a;
	return a;
}

/* ------------------------------------------------------------------ *
 * Per-application breakdowns (bounded): device totals and hostnames.
 * ------------------------------------------------------------------ */

function detail_dev(a, fr, up, down, now, dslot) {
	if (!a.devs)
		a.devs = {};
	let e = a.devs[fr.dev_key];
	if (!e) {
		if (length(a.devs) >= APP_DEV_MAX) {
			// Seed from the first candidate, not from `now`: a backwards clock
			// step (routine on an RTC-less router after its first NTP sync) can
			// push every stored `last` past now, which would leave victim null
			// and grow the map unbounded.
			let victim = null, oldest = null;
			for (let k in a.devs)
				if (oldest == null || a.devs[k].last < oldest) {
					oldest = a.devs[k].last;
					victim = k;
				}
			if (victim == null)
				return;              // cannot make room; do not exceed the cap
			delete a.devs[victim];
		}
		e = { mac: fr.dev_mac, ip: fr.dev_ip, last: now, ring: ring_new(DEVSER_SLOTS) };
		a.devs[fr.dev_key] = e;
	}
	if (fr.dev_ip)
		e.ip = fr.dev_ip;
	e.last = now;
	ring_add(e.ring, dslot, DEVSER_SLOTS, up, down);
}

function detail_host(a, fr, up, down, now) {
	if (!fr.host)
		return;
	if (!a.hosts)
		a.hosts = {};
	let e = a.hosts[fr.host];
	if (!e) {
		if (length(a.hosts) >= APP_HOST_MAX) {
			let victim = null, oldest = null;
			for (let k in a.hosts)
				if (oldest == null || a.hosts[k].last < oldest) {
					oldest = a.hosts[k].last;
					victim = k;
				}
			if (victim == null)
				return;
			delete a.hosts[victim];
		}
		// Same trailing-window ring as the device breakdown, so the two tables
		// in the detail drawer report over the same interval and stay comparable.
		e = { last: now, ring: ring_new(DEVSER_SLOTS) };
		a.hosts[fr.host] = e;
	}
	e.last = now;
	ring_add(e.ring, int(now / DEVSER_MS), DEVSER_SLOTS, up, down);
}

/* ------------------------------------------------------------------ *
 * Persistence interface (§7.3)
 *
 * v1 ships this dormant on purpose.  A history implementation (RAM-rotating
 * file, collectd exec, sqlite on USB) plugs in here without touching the
 * accounting path.  Flash-wear rule: coarse buckets only, never per sample.
 * ------------------------------------------------------------------ */

const store = {
	flush: function(_aggregates, _slot) {
		// no-op in v1
	}
};

/* ------------------------------------------------------------------ *
 * THE accounting choke point (§7.1)
 *
 * Every byte appflowd ever counts passes through here, exactly once.
 * `d_local` / `d_other` are netifyd's per-update directional deltas; the flow
 * record knows which of the two endpoints is the attributed device, so:
 *     upload   = bytes sent BY the device        (device side -> peer)
 *     download = bytes sent TO the device        (peer -> device side)
 * ------------------------------------------------------------------ */

function account(fr, d_local, d_other, ts) {
	if (fr.shadow) {                   // deduplicated NAT twin (§3.2)
		// Deliberately dropped, not lost.  Counted so that
		// bytes_reported == bytes_attributed + bytes_shadowed holds, and any
		// residual is a real leak rather than the dedup doing its job.
		let s = d_local + d_other;
		if (s > 0)
			stats.bytes_shadowed += s;
		return;
	}

	let up = fr.dev_local ? d_local : d_other;
	let down = fr.dev_local ? d_other : d_local;
	if (up < 0) up = 0;
	if (down < 0) down = 0;

	stats.bytes_attributed += up + down;
	fr.up += up;
	fr.down += down;
	fr.seen = ts;

	if (up == 0 && down == 0)
		return;

	let slot = int(ts / SERIES_MS);
	let dslot = int(ts / DEVSER_MS);

	agg_bump(totals, up, down, ts, slot);
	if (fr.a) {
		agg_bump(fr.a, up, down, ts, slot);
		detail_dev(fr.a, fr, up, down, ts, dslot);
		detail_host(fr.a, fr, up, down, ts);
	}
	if (fr.d)
		agg_bump(fr.d, up, down, ts, slot);
	if (fr.c)
		agg_bump(fr.c, up, down, ts, slot);

	// History (§7) taps in exactly here: the buckets these bumps fill are what
	// store.flush() drains once a persistent implementation exists.
}

/* ------------------------------------------------------------------ *
 * Naming (§2.3)
 * ------------------------------------------------------------------ */

// Post-capitalization fixes for tokens where naive Title Case reads wrong.
const BRAND_CAPS = {
	"Openwrt": "OpenWrt", "Dns": "DNS", "Http": "HTTP", "Https": "HTTPS",
	"Ssl": "SSL", "Tls": "TLS", "Ssh": "SSH", "Ntp": "NTP", "Vpn": "VPN",
	"Cdn": "CDN", "Voip": "VoIP", "Tv": "TV", "Api": "API", "Ip": "IP",
	"Iot": "IoT", "Ai": "AI", "Ads": "Ads",
	// Brands whose own capitalization is word-internal, which single-letter
	// Title Case cannot produce.
	"Youtube": "YouTube", "Github": "GitHub", "Gitlab": "GitLab",
	"Whatsapp": "WhatsApp", "Tiktok": "TikTok", "Paypal": "PayPal",
	"Icloud": "iCloud", "Iphone": "iPhone", "Deepl": "DeepL",
	"Openai": "OpenAI", "Openvpn": "OpenVPN", "Wireguard": "WireGuard",
	"Bittorrent": "BitTorrent", "Speedtest": "Speedtest", "Steamos": "SteamOS"
};

function title_case(s) {
	let out = [];
	for (let w in split(s, " ")) {
		let t = length(w) ? (uc(substr(w, 0, 1)) + substr(w, 1)) : w;
		push(out, BRAND_CAPS[t] ?? t);
	}
	return join(" ", out);
}

// Netify application tags look like "netify.google-ads"; nDPI protocol tags
// are already display-styled ("HTTP/S", "ZOOM", "WireGuard") and are kept
// verbatim.
function display_name(tag) {
	if (!length(tag ?? ""))
		return null;
	if (substr(tag, 0, 7) != "netify.")
		return tag;
	let slug = substr(tag, 7);
	slug = replace(slug, /[-_.]/g, " ");
	return title_case(slug);
}

function load_categories() {
	let raw, path;
	for (let p in CATEGORY_FILES) {
		try {
			raw = fs.readfile(p);
		} catch (e) {
			raw = null;
		}
		if (raw) {
			path = p;
			break;
		}
	}
	if (!raw) {
		logonce("cats", "warn", "category names unavailable: %s", join(" or ", CATEGORY_FILES));
		return;
	}

	let obj;
	try {
		obj = json(raw);
	} catch (e) {
		logmsg("warn", "%s: parse error: %s", path, e);
		return;
	}

	// The file maps tag -> id; we need id -> tag.  The far larger
	// application_index / protocol_index member lists are deliberately not
	// retained: flow events carry the category id directly.
	for (let t in obj.application_tag_index ?? {})
		catnames.app[obj.application_tag_index[t]] = t;
	for (let t in obj.protocol_tag_index ?? {})
		catnames.proto[obj.protocol_tag_index[t]] = t;
}

function load_leases(now) {
	if (leases.at && (now - leases.at) < LEASE_TTL_MS)
		return;
	leases.at = now;

	let st;
	try {
		st = fs.stat(LEASE_FILE);
	} catch (e) {
		st = null;
	}
	if (!st) {
		leases.mtime = -1;
		return;
	}
	if (st.mtime == leases.mtime)
		return;
	leases.mtime = st.mtime;

	let raw;
	try {
		raw = fs.readfile(LEASE_FILE);
	} catch (e) {
		return;
	}
	if (!raw)
		return;

	let by_mac = {}, by_ip = {};
	for (let line in split(raw, "\n")) {
		let f = split(trim(line), /[ \t]+/);
		// <expiry> <mac> <ip> <hostname> <clientid>
		if (length(f) < 4 || f[3] == "*")
			continue;
		by_mac[lc(f[1])] = f[3];
		by_ip[f[2]] = f[3];
	}
	leases.by_mac = by_mac;
	leases.by_ip = by_ip;
}

function device_name(key, mac, ip, now) {
	if (key == "router")
		return "Router";
	if (key == "unknown")
		return "Unknown";
	if (key == "multicast")
		return "Multicast / Broadcast";
	load_leases(now);
	return leases.by_mac[mac ?? ""] ?? leases.by_ip[ip ?? ""] ?? (mac ?? ip ?? key);
}

/* ------------------------------------------------------------------ *
 * Router identity — needed to tell "this box" from a client (§3.2).
 * ------------------------------------------------------------------ */

// Rebuild the router-identity maps wholesale from an interfaces block.  An
// agent_status frame that carries `interfaces` is complete and authoritative,
// so replacing rather than merging keeps these maps bounded (IPv6 privacy
// addresses and WAN re-leases would otherwise accumulate stale entries for the
// daemon's whole lifetime).  The reduced agent_status frame omits `interfaces`
// entirely — guarded by the caller — and must not wipe what we know.
function router_learn(ifaces) {
	if (type(ifaces) != "object")
		return;
	let macs = {}, ips = {};
	for (let ifname in ifaces) {
		let i = ifaces[ifname];
		if (length(i?.mac ?? ""))
			macs[lc(i.mac)] = ifname;
		for (let a in i?.addr ?? [])
			ips[a] = ifname;
	}
	router.macs = macs;
	router.ips = ips;
}

// netifyd publishes the same interface block in its status file; read it once
// at start-up so attribution is correct before the first agent_status arrives.
function router_bootstrap() {
	let raw;
	try {
		raw = fs.readfile(STATUS_FILE);
	} catch (e) {
		return;
	}
	if (!raw)
		return;
	try {
		router_learn(json(raw).interfaces);
	} catch (e) {
		// status.json is rewritten in place by netifyd; a torn read is normal
	}
}

function is_router(mac, ip) {
	return (length(mac ?? "") && router.macs[mac] != null) ||
	       (length(ip ?? "") && router.ips[ip] != null);
}

// IEEE 802 group addresses: IPv4 multicast (01:00:5e:*), IPv6 multicast
// (33:33:*) and broadcast.  These are not devices — attributing them per
// address would let any LAN host mint unbounded device aggregates by looping
// over multicast groups, so they collapse into one pseudo-device.
function is_group_mac(mac) {
	if (!length(mac ?? ""))
		return false;
	return substr(mac, 0, 8) == "01:00:5e" ||
	       substr(mac, 0, 5) == "33:33" ||
	       mac == "ff:ff:ff:ff:ff:ff";
}

/* ------------------------------------------------------------------ *
 * Flow table (§3.2, §3.3)
 * ------------------------------------------------------------------ */

function flow_detach(fr) {
	if (fr.shadow)
		return;
	if (fr.a && fr.a.cur.flows > 0) fr.a.cur.flows--;
	if (fr.d && fr.d.cur.flows > 0) fr.d.cur.flows--;
	if (fr.c && fr.c.cur.flows > 0) fr.c.cur.flows--;
}

function flow_attach(fr) {
	if (fr.shadow)
		return;
	if (fr.a) fr.a.cur.flows++;
	if (fr.d) fr.d.cur.flows++;
	if (fr.c) fr.c.cur.flows++;
}

function flow_drop(digest) {
	let fr = flows[digest];
	if (!fr)
		return;
	flow_detach(fr);
	delete flows[digest];
	nflows--;
}

// Identify (or re-identify, on a detection update) an existing flow record.
/* ------------------------------------------------------------------ *
 * NAT twin resolution (3.2)
 * ------------------------------------------------------------------ */

// On the EXTERNAL (WAN) capture of a NAT-ed flow, netifyd 4.4.7 reports the
// POST-translation identity: local_ip and local_mac are this router's own WAN
// address and MAC.  That is indistinguishable from a flow the router itself
// originated, so the capture cannot be classified from the event alone.
//
// netifyd's own ip_nat field is exactly the question being asked, and it is
// carried on the record as fr.nat, but 4.4.7 does not set it on this path:
// measured 0 true out of 24 external captures of genuinely NAT-ed client
// flows, and 0 out of 24 on the matching internal captures.  It is therefore
// read but never trusted as evidence.
//
// conntrack does know, because it holds both halves of the translation.  For a
// masqueraded flow the ORIGINAL source is the LAN client while the REPLY
// destination is this router's WAN address; for router-originated traffic the
// two are the same address:
//
//   src=192.168.1.50  dst=P ... src=P dst=192.168.72.10   <- client, NAT-ed
//   src=192.168.72.10 dst=Q ... src=Q dst=192.168.72.10   <- router's own
//
// Reading a snapshot is not free, so it is reused for CT_TTL_MS: a burst of new
// flows shares one read, and an idle router never reads at all, because loading
// is demand-driven from ct_nat_twin() below.
function ct_load(now, force) {
	if (conntrack.avail == false && (now - conntrack.probed) < CT_RETRY_MS)
		return;
	// A forced reload comes from a lookup miss, which is the ordinary case for a
	// flow younger than the current snapshot.  Honour it, but never more often
	// than CT_FORCE_MIN_MS, so a burst of new flows cannot turn into a burst of
	// reads of a file that is large on a busy router.
	if (force) {
		if ((now - conntrack.at) < CT_FORCE_MIN_MS)
			return;
	} else if (conntrack.at && (now - conntrack.at) < CT_TTL_MS) {
		// Throttle on "we read recently", NOT on "we read recently and got
		// entries".  Gating this on conntrack.entries meant a snapshot that
		// parsed to zero rows while the file was readable disabled the throttle
		// entirely, and the unforced path has no CT_FORCE_MIN_MS floor, so every
		// external flow identification re-read the whole file.
		return;
	}
	conntrack.at = now;
	conntrack.probed = now;

	// Read INCREMENTALLY, one line at a time.  This used to be fs.readfile()
	// followed by split(raw, "\n"), which materialised the entire conntrack
	// table and then the entire line array before CT_MAX was ever consulted --
	// so CT_MAX bounded the retained map but not peak allocation, and the
	// comment on the constant calling it a memory bound was wrong.  On a busy
	// router that is megabytes of transient garbage per read, on a device that
	// may have 64 MB.  Reading a line at a time makes the peak one line, and
	// the CT_MAX break now stops the work as well as the retention.
	let fd;
	try {
		fd = fs.open(cfg.conntrack_path ?? CONNTRACK_FILE, "r");
	} catch (e) {
		fd = null;
	}
	if (!fd) {
		if (conntrack.avail != false) {
			conntrack.avail = false;
			conntrack.map = {};
			conntrack.entries = 0;
			logonce("ct-missing", "warn",
			        "%s unreadable: cannot distinguish a NAT twin from router-originated traffic, so external captures are shadowed while an internal capture runs. Client accounting stays correct; the router's own traffic is not attributed.",
			        cfg.conntrack_path ?? CONNTRACK_FILE);
		}
		return;
	}
	conntrack.avail = true;

	let map = {}, n = 0;
	while (true) {
		if (n >= CT_MAX)
			break;
		let line = fd.read("line");
		if (line == null || !length(line))
			break;
		// Each line carries two tuples in order, original then reply.  Collect the
		// fields positionally rather than matching the whole line: the optional
		// state word (TIME_WAIT, [UNREPLIED], ...) shifts the columns and differs
		// between protocols.
		let src = [], dst = [], sport = [], dport = [];
		for (let tok in split(line, " ")) {
			if (substr(tok, 0, 4) == "src=")        push(src, substr(tok, 4));
			else if (substr(tok, 0, 4) == "dst=")   push(dst, substr(tok, 4));
			else if (substr(tok, 0, 6) == "sport=") push(sport, substr(tok, 6));
			else if (substr(tok, 0, 6) == "dport=") push(dport, substr(tok, 6));
		}
		if (length(src) < 2 || length(dst) < 2 || length(sport) < 2 || length(dport) < 2)
			continue;
		// Key on the reply tuple; value is whether the source was translated.
		map[src[1] + "|" + dst[1] + "|" + sport[1] + "|" + dport[1]] = (src[0] != dst[1]);
		n++;
	}
	try { fd.close(); } catch (e) {}
	conntrack.map = map;
	conntrack.entries = n;
}

// true  = this external capture is the WAN-side twin of a NAT-ed LAN flow
// false = conntrack positively says the router originated it
// null  = conntrack cannot say (absent, unreadable, or the entry has expired)
function ct_nat_twin(f, now, fr) {
	// THE PORTS COME FROM THE FLOW RECORD, NOT THE EVENT, AND THAT IS THE WHOLE
	// FIX. netifyd puts local_port/other_port on the initial `flow` event and
	// on nothing afterwards: a `flow_stats` payload carries byte counters
	// only. (This comment once said it carried addresses too. It does not, on
	// 4.4.7 or 5.x, so the addresses now come from the record as well.) This key was built straight off the event, so every call
	// made from an update produced "...|93.184.216.34|192.168.72.10||" with two
	// empty fields, matched nothing, and returned null.
	//
	// Nothing detected that. reshadow() treats null as grounds to discard, so
	// EVERY router-originated flow was shadowed on its first stats update, and
	// the "Router" device counted zero bytes on every install since 1.0.x. The
	// dashboard then correctly hides a zero-byte device, so the feature was
	// absent rather than visibly broken. Production had logged 107,476
	// positive identifications against a row reading zero for 2.6 days.
	//
	// Found 2026-08-31 by instrumenting the daemon after the row was noticed
	// missing on the bench. See tests/protocol-suite.sh `router`.
	let lp = (fr != null && fr.local_port != null) ? fr.local_port : f.local_port;
	let op = (fr != null && fr.other_port != null) ? fr.other_port : f.other_port;
	let lip = (fr != null && fr.local_ip != null) ? fr.local_ip : f.local_ip;
	let oip = (fr != null && fr.other_ip != null) ? fr.other_ip : f.other_ip;
	let key = (oip ?? "") + "|" + (lip ?? "") + "|" +
	          (op ?? "") + "|" + (lp ?? "");
	ct_load(now, false);
	let v = conntrack.entries ? conntrack.map[key] : null;
	// A miss usually means the flow is newer than the snapshot, because netifyd
	// identifies a flow within moments of it starting.  Refresh once and retry
	// before giving up: without this the common case resolves to "unknown" and
	// every router-originated flow is shadowed, which silently degrades to the
	// no-conntrack behaviour even though conntrack is available.
	if (v == null && conntrack.avail != false) {
		ct_load(now, true);
		v = conntrack.entries ? conntrack.map[key] : null;
	}
	return (v == null) ? null : v;
}

/* ------------------------------------------------------------------ *
 * AI service breakout (§10)
 *
 * WHY THIS EXISTS, measured rather than assumed.
 *
 * netifyd cannot classify AI traffic and will not soon. Its signature set,
 * /etc/netify.d/netify-apps.conf, is dated 10 August 2023 on both routers
 * checked, carries 199 application signatures, and contains ZERO entries for
 * anthropic, claude, openai, chatgpt, huggingface, perplexity, mistral,
 * copilot, bard or gemini. So this traffic arrives with detected_application 0
 * and lands in generic HTTP/S alongside everything else.
 *
 * But the identifying data is already here. netifyd reports the TLS SNI as
 * host_server_name, and flows to the real endpoints carry api.anthropic.com,
 * claude.ai and api.openai.com with no code change on our side. The daemon is
 * therefore the right layer: aggregation happens here, and the browser only
 * ever sees summarised rows.
 *
 * THIS IS HOSTNAME MATCHING, NOT DPI, AND MUST BE DESCRIBED THAT WAY. It
 * asserts a classification netifyd did not make. The technique is legitimate
 * -- matching the SNI is the same mechanism netifyd itself uses for HTTP/S --
 * but the honest framing is "we recognise the name", not "we inspected the
 * protocol".
 *
 * Three limitations, stated here so they are not discovered later:
 *
 *   - The list rots. New services appear constantly and nothing here updates
 *     itself. `ai_breakout '0'` turns the whole thing off.
 *   - ECH (Encrypted Client Hello) encrypts the SNI and would end this
 *     outright. netifyd has the identical exposure, so this is not worse than
 *     the status quo, but it is not durable either.
 *   - Region-encoded hostnames under a generic cloud domain cannot be matched
 *     by suffix without false positives. bedrock-runtime.us-east-1.amazonaws.com
 *     is the obvious example and is deliberately absent: no suffix of it is
 *     specific to Bedrock, and matching amazonaws.com would label every S3
 *     bucket on the network as AI.
 *
 * ACCOUNTING IS NOT AFFECTED. This changes an identity, never a byte count.
 * account() never sees it, so byte conservation is exactly as it was and the
 * existing conservation checks still hold.
 */

/* Keyed on a domain suffix, matched against the last two, three or four labels
 * of the SNI. Value is [ app label, category, strong ].
 *
 * THE CATEGORY IS A SLUG, NOT A DISPLAY STRING, and it must stay one. Until
 * 1.1.1 this column held "AI assistants" and its three siblings, which read
 * correctly in English and could therefore never be translated: the browser
 * renders a category by looking the slug up in a table of `_()` literals, and
 * a string that arrives already rendered has no key to look up. Every netifyd
 * category reaches the frontend as a lowercase slug; these four were the only
 * ones that did not, and they were ours. See catLabel() in common.js, which
 * carries the matching `_('AI assistants')`.
 *
 * `strong` means: override even when netifyd DID identify an application. It
 * is set only where netifyd is known to recognise the PARENT brand and would
 * otherwise swallow the AI service inside it -- Gemini reported as "Google",
 * Copilot as "GitHub". Everywhere else the rule is conservative: netifyd's own
 * answer wins, so the day Netify ships AI signatures this table goes quiet by
 * itself instead of permanently shadowing better data.
 */
