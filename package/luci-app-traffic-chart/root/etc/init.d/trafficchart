#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# /etc/init.d/trafficchart
#
# Settings: /etc/config/trafficchart (section "global"). "enabled" and "apps" are read here,
# the other options by trafficchart-agg, trafficchart-apps, trafficchart-common (shaper
# detection) and nss-trafficchart.qos.
# A "uci commit trafficchart" restarts the service (reload trigger below), so changes apply at
# once. Restarting resets the cumulative totals, the history survives.

START=99
STOP=10
USE_PROCD=1

start_service() {
    local enabled apps dns_names netify_sock
    config_load trafficchart
    config_get_bool enabled global enabled 1
    config_get_bool apps global apps 1
    config_get_bool dns_names global dns_names 1
    config_get netify_sock global sock /var/run/netifyd/netifyd.sock

    # These maps are runtime-derived data, not persistent history. Clear them
    # before starting the aggregator whenever their producer is disabled (or
    # the whole service is disabled), otherwise old labels can keep being used.
    if [ "$enabled" -ne 1 ]; then
        rm -f /var/run/trafficchart/apps.map /var/run/trafficchart/apps.map.ver \
              /var/run/trafficchart/dns.map /var/run/trafficchart/dns.map.ver 2>/dev/null
        return 0
    fi

    # netifyd -> "flow tuple -> application" map (needs socat + netifyd
    # with a [socket] listen_path); only started when both are installed
    if [ "$apps" -eq 1 ] && ! command -v socat >/dev/null 2>&1; then
        logger -t trafficchart "application names disabled: socat is not installed"
        apps=0
    fi
    # OpenWrt packages do not necessarily put netifyd in the PATH of procd/rc.common.
    # Also allow a live Netify socket as proof that the agent is available. This matters
    # on older OpenWrt/powerpc64 builds where netifyd may live outside the service PATH.
    if [ "$apps" -eq 1 ]; then
        netifyd_ok=0
        command -v netifyd >/dev/null 2>&1 && netifyd_ok=1
        for netifyd_bin in /usr/sbin/netifyd /usr/bin/netifyd /sbin/netifyd; do
            [ -x "$netifyd_bin" ] && netifyd_ok=1
        done
        [ -S /var/run/netifyd/netifyd.sock ] && netifyd_ok=1
        [ -S /var/run/netifyd/netify-sink.sock ] && netifyd_ok=1
        # The LuCI socket option is supported by trafficchart-apps. Treat that
        # explicit socket as proof of availability too, even on builds where
        # netifyd itself is outside PATH and has a nonstandard socket basename.
        case "$netify_sock" in
            /var/run/netifyd/*.sock)
                case "${netify_sock#/var/run/netifyd/}" in
                    ''|*/*|*[!A-Za-z0-9._-]*) ;;
                    *) [ -S "$netify_sock" ] && netifyd_ok=1 ;;
                esac
                ;;
        esac
        if [ "$netifyd_ok" -eq 0 ]; then
            logger -t trafficchart "application names disabled: netifyd is not installed or no Netify socket is available"
            apps=0
        fi
    fi
    # apps.map is an ephemeral snapshot belonging to one Netify reader
    # generation. Always remove it BEFORE registering agg: procd may start the
    # aggregator as soon as its instance is closed, while the apps instance
    # below is not registered/launched until later. Otherwise agg can load old
    # tuple labels during this startup window and assign them to reused tuples.
    # If cleanup fails, do not start with knowingly stale attribution.
    if ! rm -f /var/run/trafficchart/apps.map /var/run/trafficchart/apps.map.ver 2>/dev/null; then
        logger -t trafficchart "cannot clear stale apps.map before startup; refusing to start with stale application labels"
        return 1
    fi
    if [ "$dns_names" -ne 1 ]; then
        rm -f /var/run/trafficchart/dns.map /var/run/trafficchart/dns.map.ver 2>/dev/null
    fi

    # conntrack aggregator (application / device / destination totals)
    procd_open_instance agg
    procd_set_param command /usr/libexec/trafficchart-agg
    procd_set_param nice 10
    procd_set_param respawn 3600 5 0
    # on stop the daemon closes its open history buckets and writes them to the
    # persistent storage (needs a few seconds, more with a slow network share; the procd default would SIGKILL after 5 s).
    # stop_service() below asks for that flush explicitly and waits for it
    procd_set_param term_timeout 30
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance

    if [ "$apps" -eq 1 ]; then
        procd_open_instance apps
        procd_set_param command /usr/libexec/trafficchart-apps
        procd_set_param nice 10
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
    # DNS observer is independent of Netify.
    # Optional v2fly list refresh. It runs in the background and only downloads when due.
    local domain_auto_update domain_update_days
    config_get_bool domain_auto_update global domain_auto_update 1
    config_get domain_update_days global domain_update_days 7
    case "$domain_update_days" in ''|*[!0-9]*|0) domain_update_days=7 ;; esac
    # only with DNS names on: LuCI deletes domain_auto_update while dns_names is off, and the
    # default 1 below would otherwise start the updater anyway
    if [ "$dns_names" -eq 1 ] && [ "$domain_auto_update" -eq 1 ]; then
        # Keep the updater supervised for the whole service lifetime. The
        # --if-due check is cheap when no refresh is needed, and is re-run every
        # six hours so a router that stays up for months still refreshes the
        # database at the configured interval (rather than only on boot).
        umask 077
        if mkdir -p /var/run/trafficchart 2>/dev/null && chmod 700 /var/run/trafficchart 2>/dev/null; then
            procd_open_instance domain-update
            procd_set_param command /bin/sh -c 'exec "$1" --watch "$2" >> "$3" 2>&1' sh /usr/libexec/trafficchart-domains-update "$domain_update_days" /var/run/trafficchart/domains-update.log
            procd_set_param nice 10
            procd_set_param respawn 3600 5 0
            procd_close_instance
        else
            logger -t trafficchart "automatic domain-list updater not started: cannot prepare runtime directory"
        fi
    fi

    if [ "$dns_names" -eq 1 ]; then
        procd_open_instance dns
        procd_set_param command /usr/libexec/trafficchart-dns
        procd_set_param nice 10
        procd_set_param respawn
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_close_instance
    fi
}

# Runs before procd signals the instances (stop, restart, reload and shutdown/reboot): ask the
# aggregator for its final flush (closes the open 5m/1h/1d buckets and writes every persistence
# target, see hist_final() in trafficchart-agg) and wait until it has finished. The daemon notices the
# request after its current sleep (4 s normally, up to 20 s under load).
stop_service() {
    local rundir=/var/run/trafficchart pid i=0
    pid=$(cat "$rundir/agg.pid" 2>/dev/null)
    case "$pid" in ''|*[!0-9]*) return 0 ;; esac
    grep -q trafficchart-agg "/proc/$pid/cmdline" 2>/dev/null || return 0
    : > "$rundir/stop.req" 2>/dev/null || return 0
    while [ "$i" -lt 28 ] && kill -0 "$pid" 2>/dev/null; do sleep 1; i=$((i + 1)); done
    [ "$i" -ge 28 ] && logger -t trafficchart "final history flush did not finish within 28 s"
    return 0
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger trafficchart
}
