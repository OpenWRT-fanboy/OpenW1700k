#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# trafficchart-apps - netifyd JSON stream -> "flow tuple -> application" map
#
# Connects to netifyd's JSON socket (see [socket] listen_path in
# /etc/netifyd.conf), keeps an in-memory map
#     proto|localip|otherip|localport|otherport  ->  application
# (value = application TAB host name) and writes it (atomically, only when changed, at most every
# FLUSH_MS) to
# $OUT_DIR/apps.map for trafficchart-agg (and bumps $OUT_DIR/apps.map.ver after
# every write, so the aggregator only re-reads the map when it really changed). Only IDENTITY comes from netifyd;
# all byte/packet numbers still come from conntrack, because netifyd counts
# packets it captures and NSS-offloaded flows stop being captured after
# their first packets. netifyd names the flow from its first packets (DNS
# cache hit / SNI / QUIC initial), so the label arrives in time anyway.
#
# Needs: socat and a Netify JSON socket. Netify 4.x/5.0/5.1 use netifyd.sock;
# newer 5.x may use netify-sink.sock.
# Environment: SOCK OUT_DIR AWK SOCAT TC_COMMON

# Settings: /etc/config/trafficchart option "sock" (or the environment variable SOCK),
# see Traffic Chart Settings. Needs trafficchart-common (tc_cfg).
. "${TC_COMMON:-/usr/libexec/trafficchart-common}" || exit 1
tc_cfg SOCK /var/run/netifyd/netifyd.sock sock
# Minimum time between two writes of apps.map (ms). A new flow's label has to reach the
# aggregator before its hold time (APP_HOLD-1)*INTERVAL runs out; worst case is this delay
# plus one aggregator poll, so half the aggregator interval (option interval, default 4 s) is safe.
tc_cfg INTERVAL 4 pint
FLUSH_MS=$((INTERVAL * 500))
[ "$FLUSH_MS" -ge 1000 ] || FLUSH_MS=1000
OUT_DIR="${OUT_DIR:-/var/run/trafficchart}"
AWK="${AWK:-awk}"
SOCAT="${SOCAT:-socat}"
ONCE="${ONCE:-0}"      # testing: read stdin once instead of the socket loop

umask 077
mkdir -p "$OUT_DIR" || exit 1
chmod 700 "$OUT_DIR" 2>/dev/null || exit 1

# apps.map is a snapshot of the CURRENT Netify reader's flow tuples, not a
# durable cache. When this service (or its socket reader) restarts, the old
# process may have left tuple labels behind. Clear the snapshot and bump its
# version before waiting for Netify, otherwise stale tuple reuse can label a
# new connection with the previous connection's application indefinitely.
MAP_RESET_SEQ=0
publish_empty_map() {
    MAP_RESET_SEQ=$((MAP_RESET_SEQ + 1))
    local tmp ver_tmp stamp
    tmp="$OUT_DIR/apps.map.tmp.$$"
    ver_tmp="$OUT_DIR/apps.map.ver.tmp.$$"
    if ! : > "$tmp" || ! mv -f "$tmp" "$OUT_DIR/apps.map"; then
        rm -f "$tmp"
        # Missing version means the aggregator deliberately re-reads the map
        # every poll, so this fallback avoids retaining an in-memory stale map.
        if rm -f "$OUT_DIR/apps.map" "$OUT_DIR/apps.map.ver" 2>/dev/null; then
            logger -t trafficchart "could not atomically clear apps.map; switched to unversioned refresh"
            return 0
        fi
        return 1
    fi
    stamp="$(date +%s 2>/dev/null || echo 0).$$.reset$MAP_RESET_SEQ"
    if ! printf '%s\n' "$stamp" > "$ver_tmp" || ! mv -f "$ver_tmp" "$OUT_DIR/apps.map.ver"; then
        rm -f "$ver_tmp" "$OUT_DIR/apps.map.ver" 2>/dev/null
        logger -t trafficchart "could not publish apps.map version; aggregator will refresh the map every poll"
    fi
    return 0
}

# Clear even if the Netify binary exists but its socket is not available yet.
publish_empty_map || { logger -t trafficchart "could not clear stale apps.map"; exit 1; }

if [ "$ONCE" != "1" ] && ! command -v "$SOCAT" >/dev/null 2>&1; then
    logger -t trafficchart "socat not installed - application names disabled, everything else unaffected"
    while true; do sleep 3600; done
fi

run_reader() {
    # TMPID: private temp file name per instance, so two instances (or a stale
    # one after a restart) can never move each other's temp file away
    exec $AWK -v MAP="$OUT_DIR/apps.map" -v TMPID="$$" -v FLUSH_MS="$FLUSH_MS" '
    # Decode JSON string escapes, including Unicode escapes. Netify commonly emits UTF-8
    # directly, but escaped labels are equally valid JSON and must not turn "Hulu\u00e9"
    # into the different application name "Huluu00e9".
    function hexval(c) { return index("0123456789abcdef", tolower(c)) - 1 }
    function hex4(s,   i,d,v) {
        if (length(s) != 4) return -1
        v = 0
        for (i = 1; i <= 4; i++) { d = hexval(substr(s, i, 1)); if (d < 0) return -1; v = v * 16 + d }
        return v
    }
    function utf8(cp) {
        if (cp < 128) return sprintf("%c", cp)
        if (cp < 2048) return sprintf("%c%c", 192 + int(cp / 64), 128 + cp % 64)
        if (cp < 65536) return sprintf("%c%c%c", 224 + int(cp / 4096), 128 + int(cp / 64) % 64, 128 + cp % 64)
        return sprintf("%c%c%c%c", 240 + int(cp / 262144), 128 + int(cp / 4096) % 64, 128 + int(cp / 64) % 64, 128 + cp % 64)
    }
    function unescape(s,   out, i, n, c, cp, low) {
        n = length(s); out = ""
        for (i = 1; i <= n; i++) {
            c = substr(s, i, 1)
            if (c == "\\" && i < n) {
                i++
                c = substr(s, i, 1)
                if (c == "u" && i + 4 <= n) {
                    cp = hex4(substr(s, i + 1, 4))
                    if (cp >= 0) {
                        # Leave i on the final hex digit. The for-loop increment then
                        # advances to the character after this escape (without skipping it).
                        i += 4
                        # JSON represents non-BMP code points as a UTF-16 surrogate pair.
                        if (cp >= 55296 && cp <= 56319) {
                            if (substr(s, i + 1, 2) == "\\u" && i + 5 <= n) {
                                low = hex4(substr(s, i + 3, 4))
                                if (low >= 56320 && low <= 57343) { cp = 65536 + (cp - 55296) * 1024 + low - 56320; i += 6 }
                                else cp = 65533
                            } else cp = 65533
                        } else if (cp >= 56320 && cp <= 57343) cp = 65533
                        out = out utf8(cp)
                        continue
                    }
                }
                if (c == "n" || c == "t" || c == "r") c = " "
                else if (c == "b") c = sprintf("%c", 8)
                else if (c == "f") c = sprintf("%c", 12)
                # For valid JSON escapes, quote, backslash and slash are now unescaped.
            }
            out = out c
        }
        return out
    }
    # extract "key":"value" / "key":123 from a one-line JSON object; the pattern walks over
    # escaped pairs, so an escaped quote does not end the value
    function jstr(l, k, tail, p) {
        # JSON permits insignificant whitespace around the colon. Extract from
        # the matched key/value pair rather than relying on a fixed byte offset.
        if (match(l, "\"" k "\"[ \t]*:[ \t]*\"(\\\\.|[^\"\\\\])*\"")) {
            tail = substr(l, RSTART, RLENGTH)
            p = index(tail, ":") + 1
            while (substr(tail, p, 1) ~ /[ \t]/) p++
            p++ # opening quote
            return unescape(substr(tail, p, length(tail) - p))
        }
        return ""
    }
    function jnum(l, k, tail) {
        if (match(l, "\"" k "\"[ \t]*:[ \t]*[0-9]+")) {
            tail = substr(l, RSTART, RLENGTH)
            sub(/^[^:]*:[ \t]*/, "", tail)
            return tail + 0
        }
        return -1
    }
    # Netify may revise digest as DPI classification becomes richer. The first
    # digest_prev value identifies the existing flow; use it for both mapping and
    # purge so a digest revision cannot leak an extra tuple reference.
    function flow_digest(l, tail, p) {
        if (match(l, /"digest_prev"[ \t]*:[ \t]*\[[ \t]*"[^"]+"/)) {
            tail = substr(l, RSTART, RLENGTH)
            p = index(tail, "[") + 1
            while (substr(tail, p, 1) ~ /[ \t]/) p++
            p++ # opening quote of the first previous digest
            tail = unescape(substr(tail, p, length(tail) - p))
            if (tail != "") return tail
        }
        return jstr(l, "digest")
    }
    # conntrack prints IPv6 fully expanded and zero padded (%pI6);
    # netifyd prints it compressed
    function v6full(a,   n, h, lc, rc, lg, rg, i, g, out, miss, ip, oct, tail) {
        if (index(a, ":") == 0) return a
        # inet_ntop-style IPv6 text can include a dotted-decimal IPv4 tail; convert it to two hextets before expansion.
        if (a ~ /\./) {
            ip = a
            if (ip !~ /:[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return tolower(a)
            sub(/^.*:/, "", ip)
            if (split(ip, oct, ".") != 4) return tolower(a)
            for (i = 1; i <= 4; i++) if (oct[i] !~ /^[0-9]+$/ || oct[i] + 0 > 255) return tolower(a)
            tail = sprintf("%x:%x", (oct[1] + 0) * 256 + (oct[2] + 0), (oct[3] + 0) * 256 + (oct[4] + 0))
            sub(/[^:]*$/, tail, a)
        }
        a = tolower(a)
        if (a ~ /:::/) return a
        n = split(a, h, "::")
        if (n > 2) return a
        if (n == 1) { lc = split(h[1], lg, ":"); rc = 0; miss = 0 }
        else {
            lc = (h[1] == "") ? 0 : split(h[1], lg, ":")
            rc = (h[2] == "") ? 0 : split(h[2], rg, ":")
            miss = 8 - lc - rc
        }
        if (miss < 0) return tolower(a)
        out = ""
        for (i = 1; i <= lc; i++) { g = tolower(lg[i]); while (length(g) < 4) g = "0" g; out = out (out == "" ? "" : ":") g }
        for (i = 1; i <= miss; i++) out = out (out == "" ? "" : ":") "0000"
        for (i = 1; i <= rc; i++) { g = tolower(rg[i]); while (length(g) < 4) g = "0" g; out = out (out == "" ? "" : ":") g }
        return out
    }
    BEGIN {
        # version stamp = start time + instance id + counter: unique even if this
        # reader is restarted (the counter alone would start from 1 again)
        "date +%s" | getline ep; close("date +%s")
        VER0 = ep "." TMPID
    }
    function flush(   k, tmp, nd) {
        # Expire tuple state BEFORE publishing the snapshot. Previously the map
        # was written and its version advanced first; deleting expired dead[]
        # entries afterwards only changed memory. If Netify then went quiet, the
        # stale tuple remained in apps.map indefinitely because no later flush was
        # guaranteed to occur. A digest-less flow first gets the documented 30 s
        # no-sighting window, then the existing 30 s dead[] grace period.
        nd = 0
        for (k in dead) {
            if (now - dead[k] > 30000) { delete dead[k]; delete map[k] }
            else nd++
        }
        # Flows without digest never get a purge event: once one has not been
        # confirmed by a flow line for 30 s, hand it to the dead[] grace-period path above.
        for (k in nodig_last) {
            if (now - nodig_last[k] > 30000) {
                delete nodig_last[k]
                if (!(k in dead)) { dead[k] = now; nd++ }
            } else nd++
        }
        deadflag = (nd > 0)

        tmp = MAP ".tmp." TMPID
        printf "" > tmp          # truncate; also makes an empty map valid
        for (k in map) printf "%s\t%s\n", k, map[k] > tmp
        close(tmp)
        if (system("mv -f " tmp " " MAP) != 0) { dirty = 1; return }
        # Publish the version only AFTER the cleaned map is on disk.
        printf "%s.%d\\n", VER0, ++nflush > (MAP ".ver")
        close(MAP ".ver")
        dirty = 0; lastflush = now
    }
    function on_flow(l,   app, host, val, ip, proto, lip, oip, lp, op, key, dg, oldkey, oldrefs) {
        app = jstr(l, "detected_application_name")
        if (app == "" || app == "Unknown") app = jstr(l, "detected_protocol_name")
        if (app == "") app = "Unknown"
        sub(/^netify\./, "", app)
        # host name netifyd saw (SNI, else DNS cache); may be empty
        host = jstr(l, "host_server_name")
        if (host == "") host = jstr(l, "dns_host_name")
        gsub(/[^A-Za-z0-9._:-]/, "_", host)
        val = app "\t" host
        ip = jnum(l, "ip_protocol")
        if (ip == 6) proto = "tcp"; else if (ip == 17) proto = "udp"; else return
        lip = jstr(l, "local_ip"); oip = jstr(l, "other_ip")
        lp = jnum(l, "local_port"); op = jnum(l, "other_port")
        if (lip == "" || oip == "" || lp < 0 || op < 0) return
        key = proto "|" v6full(lip) "|" v6full(oip) "|" lp "|" op
        dg = flow_digest(l)
        # A flow without digest cannot go through dg2key/kref (all of them would collide
        # on the empty key): it is tracked by last sighting instead (nodig_last[],
        # swept in flush()).
        if (dg != "") {
            # Once this tuple has a digest-backed flow, the no-digest idle timer
            # must no longer be allowed to expire it. A flow can first arrive
            # without a digest and later be upgraded; leaving nodig_last[key]
            # behind would mark the still-live tuple dead after 30 s and remove
            # its app label on a later unrelated flush.
            delete nodig_last[key]
            if (dg in dg2key) {
                # Normally a digest stays with one tuple. If Netify reuses/reassigns
                # it (or the tuple identity changes across an agent restart), transfer
                # the reference instead of leaving the old tuple permanently retained
                # with a stale kref and the new tuple with no reference count.
                oldkey = dg2key[dg]
                if (oldkey != key) {
                    oldrefs = (oldkey in kref) ? kref[oldkey] - 1 : 0
                    if (oldrefs <= 0) {
                        delete kref[oldkey]
                        dead[oldkey] = now; deadflag = 1
                    } else kref[oldkey] = oldrefs
                    kref[key]++
                }
            } else kref[key]++
            dg2key[dg] = key
        } else {
            # Do not start a no-digest expiry timer while another live digest
            # currently keeps this same tuple referenced. If that digest purges,
            # the normal kref/dead path handles its grace period.
            if (key in kref) delete nodig_last[key]
            else nodig_last[key] = now
        }
        delete dead[key]
        if (map[key] != val) { map[key] = val; dirty = 1 }
    }
    function on_purge(l,   dg, k) {
        dg = flow_digest(l)
        if (dg == "" || !(dg in dg2key)) return
        k = dg2key[dg]; delete dg2key[dg]
        if (--kref[k] <= 0) { delete kref[k]; dead[k] = now; deadflag = 1 }
    }
    {
        # Dispatch by the parsed JSON value, not by a compact textual substring:
        # JSON permits whitespace around ':' here just as it does for all other fields.
        event = jstr($0, "type")
        if (event == "flow" || event == "flow_dpi_update" || event == "flow_dpi_complete") {
            # Netify v5 can deliver the classification after the initial flow event.
            # Treat DPI updates/completion as revisions of the same tuple mapping.
            now = jnum($0, "last_seen_at"); if (now < 0) now = lastflush
            on_flow($0)
        } else if (event == "flow_purge") {
            now = jnum($0, "last_seen_at"); if (now < 0) now = lastflush
            on_purge($0)
        } else if (event == "agent_status") {
            now = jnum($0, "timestamp") * 1000
        } else next
        if ((dirty || deadflag) && (now - lastflush >= FLUSH_MS || now < lastflush)) flush()
    }
    END { flush() }
    '
}

if [ "$ONCE" = "1" ]; then
    run_reader
    exit 0
fi

# netifyd may not be up yet, or restart: keep reconnecting.
#
# socat and the reader are started as separate background jobs (joined by a
# fifo) instead of "socat | reader": when procd stops the service it only
# signals THIS shell, and in a plain pipeline socat and awk would live on as
# orphans, one more pair for every restart, all reading the same netifyd
# stream and racing on apps.map. The trap kills both children on TERM/INT/HUP.
FIFO="$OUT_DIR/netifyd.$$.fifo"
SPID=""; RPID=""
cleanup() {
    trap - TERM INT HUP EXIT
    [ -n "$RPID" ] && kill "$RPID" 2>/dev/null
    [ -n "$SPID" ] && kill "$SPID" 2>/dev/null
    rm -f "$FIFO"
    exit 0
}
trap cleanup TERM INT HUP EXIT

while true; do
    case "$SOCK" in
        /var/run/netifyd/*.sock)
            case "${SOCK#/var/run/netifyd/}" in
                ''|*/*|*[!A-Za-z0-9._-]*) SOCK="" ;;
            esac
            ;;
        *) SOCK="" ;;
    esac
    # Auto-select the socket when the configured/default socket is absent.
    # Netify 4.x and 5.0/5.1 expose the flow stream on netifyd.sock; newer 5.x
    # releases may expose it through the sink socket. An explicitly configured
    # existing socket is always preferred.
    if [ -z "$SOCK" ] || [ ! -S "$SOCK" ]; then
        if [ -S /var/run/netifyd/netifyd.sock ]; then
            SOCK=/var/run/netifyd/netifyd.sock
        elif [ -S /var/run/netifyd/netify-sink.sock ]; then
            SOCK=/var/run/netifyd/netify-sink.sock
        fi
    fi
    if [ -n "$SOCK" ] && [ -S "$SOCK" ]; then
        rm -f "$FIFO"
        if mkfifo "$FIFO" 2>/dev/null; then
            $SOCAT -u "UNIX-CONNECT:$SOCK" - 2>/dev/null > "$FIFO" &
            SPID=$!
            run_reader < "$FIFO" &
            RPID=$!
            wait "$RPID"
            kill "$SPID" 2>/dev/null
            SPID=""; RPID=""
        else
            # no mkfifo in this busybox: plain pipeline (no orphan protection)
            $SOCAT -u "UNIX-CONNECT:$SOCK" - 2>/dev/null | run_reader
        fi
        # The reader's END block flushes its last in-memory snapshot. Clear it
        # again after the reader exits so a disconnected Netify agent cannot
        # leave mappings active while the reconnect loop waits for its socket.
        publish_empty_map || logger -t trafficchart "could not clear apps.map after reader exit"
    fi
    # interruptible pause, so a TERM from procd is handled at once
    sleep 5 &
    wait $!
done
