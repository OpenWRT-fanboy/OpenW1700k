From: Chad Monroe <chad@monroe.io>
Date: Sun, 02 Feb 2026 10:30:00 -0800
Subject: [PATCH] netfilter: nf_flow_table: invalidate flows on bridge FDB
 roaming

When a client roams between bridge ports (WiFi APs, wired to wireless,
etc.), offloaded flows with stale destination MACs continue forwarding
to the wrong port until they time out.

Register a switchdev notifier to detect FDB deletions and tear down
affected flows immediately.  Workqueue defers cleanup from atomic
notifier context.  The cleanup iterator matches flows whose
tuplehash[*].tuple.out.h_dest equals the roaming MAC, then drains the
GC and offload workqueues and runs a second GC pass to evict
HW_DEAD-marked entries from the rhashtable immediately (rather than
waiting ~1s for the next periodic GC), so new flows with the same
5-tuple can be created without delay.

Optimizations to reduce CPU overhead under FDB churn:
- Track a per-flowtable direct_xmit_count and skip flowtables with no
  direct-xmit flows in the cleanup iterator.  Without direct-xmit flows
  a flowtable cannot hold MAC-keyed entries, so the MAC sweep is a no-op.
- Skip multicast/broadcast FDB entries, is_local entries, and events on
  non-oper-up devices at the notifier itself.

Add a generation counter to prevent a rapid disconnect/reconnect race:
client disconnects -> FDB DEL queued -> client reconnects -> new flow
created -> stale cleanup tears down the new flow.  The counter is
incremented on each FDB DEL event; flows stamp their creation
generation; the cleanup iterator skips flows whose cleanup_gen is at or
after the generation that triggered the cleanup.

The generation is bumped via atomic_inc_return() in the switchdev
notifier and the resulting value is passed through to the cleanup work
(rather than being re-read from the global counter inside
nf_flow_table_cleanup_mac()).  This closes a race where a flow created
between this event's bump and a subsequent event's bump would be wrongly
torn down by the earlier event's cleanup work (the work's gen would
have been re-read after the later bump, making it newer than the new
flow's cleanup_gen).  If the GFP_ATOMIC allocation in
nf_flow_table_cleanup_mac() fails, no cleanup runs for this event but
the gen counter is still advanced; this is safe because future flows
simply stamp a higher cleanup_gen, and any flow that should have been
torn down by the missed event will be caught by the next cleanup for
the same MAC or by the periodic GC.

Reduce the default bridge FDB ageing time from 300s to 30s (matching
802.1D-2004 clause 17.11.5).  This is the safety net for stale entries
that the switchdev FDB DEL notifier misses: when a WiFi STA
disconnects, its FDB entry now ages out in 30s instead of 5 minutes,
preventing hardware-offloaded flows from forwarding into a dead path.

Companion patches:
- 990-02 (airoha_ppe): fixes flow teardown/re-insertion and the
  foe_flow bucket lookup that this patch's teardown relies on for HW
  re-commit after roaming.
- package/kernel/mt76/patches/0012: makes the WiFi NPU RX path always
  call check_skb so torn-down flows can be re-committed after roaming.

Signed-off-by: Chad Monroe <chad@monroe.io>
---
 include/linux/if_bridge.h             |    2 +-
 include/net/netfilter/nf_flow_table.h |   11 ++
 net/netfilter/nf_flow_table_core.c    |  165 +++++++++++++++++++++++
 3 files changed, 177 insertions(+), 1 deletion(-)

diff --git a/include/linux/if_bridge.h b/include/linux/if_bridge.h
index c5fe3b2..04c43c1 100644
--- a/include/linux/if_bridge.h
+++ b/include/linux/if_bridge.h
@@ -62,7 +62,7 @@ struct br_ip_list {
 #define BR_PORT_MAB		BIT(22)
 #define BR_NEIGH_VLAN_SUPPRESS	BIT(23)
 
-#define BR_DEFAULT_AGEING_TIME	(300 * HZ)
+#define BR_DEFAULT_AGEING_TIME	(30 * HZ)
 
 struct net_bridge;
 void brioctl_set(int (*hook)(struct net *net, unsigned int cmd,
diff --git a/include/net/netfilter/nf_flow_table.h b/include/net/netfilter/nf_flow_table.h
index c003cd1..9cb3682 100644
--- a/include/net/netfilter/nf_flow_table.h
+++ b/include/net/netfilter/nf_flow_table.h
@@ -84,6 +84,9 @@ struct nf_flowtable {
 	struct flow_block		flow_block;
 	struct rw_semaphore		flow_block_lock; /* Guards flow_block */
 	possible_net_t			net;
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	atomic_t			direct_xmit_count;
+#endif
 };
 
 static inline bool nf_flowtable_hw_offload(struct nf_flowtable *flowtable)
@@ -91,6 +94,13 @@ static inline bool nf_flowtable_hw_offload(struct nf_flowtable *flowtable)
 	return flowtable->flags & NF_FLOWTABLE_HW_OFFLOAD;
 }
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+static inline bool nf_flowtable_has_direct_xmit(struct nf_flowtable *flowtable)
+{
+	return atomic_read(&flowtable->direct_xmit_count) > 0;
+}
+#endif
+
 enum flow_offload_tuple_dir {
 	FLOW_OFFLOAD_DIR_ORIGINAL = IP_CT_DIR_ORIGINAL,
 	FLOW_OFFLOAD_DIR_REPLY = IP_CT_DIR_REPLY,
@@ -184,6 +194,7 @@ struct flow_offload {
 	unsigned long				flags;
 	u16					type;
 	u32					timeout;
+	u32					cleanup_gen;
 	struct rcu_head				rcu_head;
 };
 
diff --git a/net/netfilter/nf_flow_table_core.c b/net/netfilter/nf_flow_table_core.c
--- a/net/netfilter/nf_flow_table_core.c
+++ b/net/netfilter/nf_flow_table_core.c
@@ -5,6 +5,7 @@
 #include <linux/netfilter.h>
 #include <linux/rhashtable.h>
 #include <linux/netdevice.h>
+#include <linux/etherdevice.h>
 #include <net/ip.h>
 #include <net/ip6_route.h>
 #include <net/netfilter/nf_tables.h>
@@ -12,10 +13,26 @@
 #include <net/netfilter/nf_conntrack_core.h>
 #include <net/netfilter/nf_conntrack_l4proto.h>
 #include <net/netfilter/nf_conntrack_tuple.h>
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+#include <net/switchdev.h>
+#endif
 
 static DEFINE_MUTEX(flowtable_lock);
 static LIST_HEAD(flowtables);
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+static struct workqueue_struct *flow_mac_cleanup_wq;
+
+struct flow_mac_cleanup {
+	struct work_struct work;
+	struct net *net;
+	unsigned char mac[ETH_ALEN];
+	u32 gen;
+};
+#endif
+
+static atomic_t flow_mac_cleanup_gen;
+
 static void
 flow_offload_fill_dir(struct flow_offload *flow,
 		      enum flow_offload_tuple_dir dir)
@@ -340,6 +357,13 @@ int flow_offload_add(struct nf_flowtable *flow_table, struct flow_offload *flow)
 
 	nf_ct_refresh(flow->ct, NF_CT_DAY);
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	flow->cleanup_gen = atomic_read(&flow_mac_cleanup_gen);
+	if (flow->tuplehash[0].tuple.xmit_type == FLOW_OFFLOAD_XMIT_DIRECT ||
+	    flow->tuplehash[1].tuple.xmit_type == FLOW_OFFLOAD_XMIT_DIRECT)
+		atomic_inc(&flow_table->direct_xmit_count);
+#endif
+
 	if (nf_flowtable_hw_offload(flow_table)) {
 		__set_bit(NF_FLOW_HW, &flow->flags);
 		nf_flow_offload_add(flow_table, flow);
@@ -370,6 +397,11 @@ EXPORT_SYMBOL_GPL(flow_offload_refresh);
 static void flow_offload_del(struct nf_flowtable *flow_table,
 			     struct flow_offload *flow)
 {
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	if (flow->tuplehash[0].tuple.xmit_type == FLOW_OFFLOAD_XMIT_DIRECT ||
+	    flow->tuplehash[1].tuple.xmit_type == FLOW_OFFLOAD_XMIT_DIRECT)
+		atomic_dec(&flow_table->direct_xmit_count);
+#endif
 	rhashtable_remove_fast(&flow_table->rhashtable,
 			       &flow->tuplehash[FLOW_OFFLOAD_DIR_ORIGINAL].node,
 			       nf_flow_offload_rhash_params);
@@ -696,6 +728,9 @@ int nf_flow_table_init(struct nf_flowtable *flowtable)
 	INIT_DELAYED_WORK(&flowtable->gc_work, nf_flow_offload_work_gc);
 	flow_block_init(&flowtable->flow_block);
 	init_rwsem(&flowtable->flow_block_lock);
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	atomic_set(&flowtable->direct_xmit_count, 0);
+#endif
 
 	err = rhashtable_init(&flowtable->rhashtable,
 			      &nf_flow_offload_rhash_params);
@@ -748,6 +783,116 @@ void nf_flow_table_cleanup(struct net_device *dev)
 }
 EXPORT_SYMBOL_GPL(nf_flow_table_cleanup);
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+static void nf_flow_table_do_cleanup_mac(struct nf_flowtable *flowtable,
+					 struct flow_offload *flow, void *data)
+{
+	struct flow_mac_cleanup *cleanup = data;
+
+	if (!net_eq(nf_ct_net(flow->ct), cleanup->net))
+		return;
+
+	if (flow->cleanup_gen >= cleanup->gen)
+		return;
+
+	if (ether_addr_equal(flow->tuplehash[0].tuple.out.h_dest, cleanup->mac) ||
+	    ether_addr_equal(flow->tuplehash[1].tuple.out.h_dest, cleanup->mac)) {
+		flow_offload_teardown(flow);
+	}
+}
+
+static void nf_flow_table_mac_cleanup_work(struct work_struct *work)
+{
+	struct flow_mac_cleanup *cleanup =
+		container_of(work, struct flow_mac_cleanup, work);
+	struct nf_flowtable *flowtable;
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list) {
+		if (nf_flowtable_has_direct_xmit(flowtable))
+			nf_flow_table_iterate(flowtable,
+						  nf_flow_table_do_cleanup_mac, cleanup);
+
+		/* do this implicitly.. it seems to help expire software path
+		 * entries faster but still need to get concrete data */
+		flush_delayed_work(&flowtable->gc_work);
+		nf_flow_table_offload_flush(flowtable);
+		/* Second GC pass: the first GC pass queued FLOW_CLS_DESTROY
+		 * and the offload flush completed it, setting HW_DEAD on
+		 * affected flows.  Run GC again to immediately remove their
+		 * tuplehash entries from the rhashtable, allowing new flows
+		 * with the same 5-tuple to be created without waiting for
+		 * the next periodic GC run (~1s).
+		 */
+		nf_flow_table_gc_run(flowtable);
+	}
+	mutex_unlock(&flowtable_lock);
+
+	put_net(cleanup->net);
+	kfree(cleanup);
+}
+
+static void nf_flow_table_cleanup_mac(struct net *net, const unsigned char *mac,
+				      u32 gen)
+{
+	struct flow_mac_cleanup *cleanup;
+
+	cleanup = kmalloc(sizeof(*cleanup), GFP_ATOMIC);
+	if (!cleanup)
+		return;
+
+	cleanup->gen = gen;
+	cleanup->net = get_net(net);
+	memcpy(cleanup->mac, mac, ETH_ALEN);
+	INIT_WORK(&cleanup->work, nf_flow_table_mac_cleanup_work);
+	queue_work(flow_mac_cleanup_wq, &cleanup->work);
+}
+
+static int nf_flow_table_switchdev_event(struct notifier_block *nb,
+					 unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb_info = ptr;
+	u32 gen;
+
+	if (event != SWITCHDEV_FDB_DEL_TO_DEVICE)
+		return NOTIFY_DONE;
+
+	if (!fdb_info || !fdb_info->addr)
+		return NOTIFY_DONE;
+
+	if (is_multicast_ether_addr(fdb_info->addr))
+		return NOTIFY_DONE;
+
+	if (fdb_info->is_local)
+		return NOTIFY_DONE;
+
+	if (!netif_oper_up(fdb_info->info.dev))
+		return NOTIFY_DONE;
+
+	/* Capture the bumped generation at the notifier so the cleanup work
+	 * uses the generation that corresponds to *this* FDB DEL event rather
+	 * than re-reading the global counter, which may have advanced further
+	 * by the time the work is scheduled.  This closes a race where a flow
+	 * created between this event's bump and a subsequent bump would be
+	 * wrongly torn down by the earlier event's cleanup work.
+	 * The bump is done via atomic_inc_return so it is atomic with the
+	 * value capture.  If the subsequent kmalloc in
+	 * nf_flow_table_cleanup_mac() fails, no cleanup runs for this event;
+	 * the gen counter is still moved forward, which is safe because it
+	 * only causes future flows to stamp a higher cleanup_gen (and thus
+	 * be skipped by any future cleanup that does run).
+	 */
+	gen = atomic_inc_return(&flow_mac_cleanup_gen);
+
+	nf_flow_table_cleanup_mac(dev_net(fdb_info->info.dev), fdb_info->addr, gen);
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block flow_offload_switchdev_notifier = {
+	.notifier_call = nf_flow_table_switchdev_event,
+};
+#endif
+
 void nf_flow_table_free(struct nf_flowtable *flow_table)
 {
 	mutex_lock(&flowtable_lock);
@@ -846,8 +976,26 @@ static int __init nf_flow_table_module_init(void)
 	if (ret)
 		goto out_bpf;
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	flow_mac_cleanup_wq = alloc_workqueue("nf_flow_mac_cleanup",
+					      WQ_UNBOUND, 0);
+	if (!flow_mac_cleanup_wq) {
+		ret = -ENOMEM;
+		goto out_wq;
+	}
+
+	ret = register_switchdev_notifier(&flow_offload_switchdev_notifier);
+	if (ret)
+		goto out_switchdev;
+#endif
+
 	return 0;
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+out_switchdev:
+	destroy_workqueue(flow_mac_cleanup_wq);
+out_wq:
+#endif
 out_bpf:
 	nf_flow_table_offload_exit();
 out_offload:
@@ -857,6 +1005,11 @@ out_offload:
 
 static void __exit nf_flow_table_module_exit(void)
 {
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+	unregister_switchdev_notifier(&flow_offload_switchdev_notifier);
+	flush_workqueue(flow_mac_cleanup_wq);
+	destroy_workqueue(flow_mac_cleanup_wq);
+#endif
 	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 	nf_flow_table_offload_exit();
 	unregister_pernet_subsys(&nf_flow_table_net_ops);
