+static u32 airoha_ppe_foe_ingress(struct sk_buff *skb)
+{
+	struct net_device *ndev = skb->dev;
+#if IS_ENABLED(CONFIG_NET_DSA)
+	struct metadata_dst *md_dst = skb_metadata_dst(skb);
+	struct dsa_port *udp;
+
+	if (md_dst && md_dst->type == METADATA_HW_PORT_MUX && ndev->dsa_ptr) {
+		udp = dsa_to_port(ndev->dsa_ptr->ds,
+				  md_dst->u.port_info.port_id);
+		if (udp && dsa_port_is_user(udp) && udp->user)
+			return udp->user->ifindex;
+	}
+#endif
+	return ndev ? ndev->ifindex : 0;
+}
+
+#define AIROHA_L2_DUAL_WINDOW	msecs_to_jiffies(10000)
+
+static bool airoha_ppe_foe_l2_claim(struct airoha_ppe *ppe,
+				    struct airoha_flow_table_entry *e,
+				    u32 ingress)
+{
+	struct airoha_flow_table_entry *f;
+	struct hlist_node *n;
+	unsigned long now = jiffies;
+	bool dual;
+
+	if (e->no_hw_since &&
+	    time_after(now, e->no_hw_since + AIROHA_L2_DUAL_WINDOW))
+		e->no_hw_since = 0;
+
+	dual = e->no_hw_since ||
+	       (ingress && e->ingress_dev_idx &&
+		ingress != e->ingress_dev_idx &&
+		time_before(now, e->ingress_stamp + AIROHA_L2_DUAL_WINDOW));
+	if (dual) {
+		hlist_for_each_entry_safe(f, n, &e->l2_flows,
+					  l2_subflow_node)
+			airoha_ppe_foe_remove_flow(ppe, f);
+		if (!e->no_hw_since)
+			e->no_hw_since = now;
+		return true;
+	}
+
+	if (ingress) {
+		e->ingress_dev_idx = ingress;
+		e->ingress_stamp = now;
+	}
+
+	return false;
+}
