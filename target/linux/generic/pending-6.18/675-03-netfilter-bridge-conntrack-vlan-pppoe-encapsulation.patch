+		data->inner_vlan_present = true;
+		data->inner_vlan_tci = ntohs(vhdr->h_vlan_TCI);
+		data->inner_vlan_proto = vhdr->h_vlan_encapsulated_proto;
+		*proto = vhdr->h_vlan_encapsulated_proto;
+		return VLAN_HLEN;
