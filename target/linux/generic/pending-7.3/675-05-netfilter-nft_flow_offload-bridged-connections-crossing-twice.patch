From: Tao Gong <gongtao0607@gmail.com>
Subject: [PATCH] netfilter: nft_flow_offload: do not offload bridged connections crossing twice

A connection routed by a router reached through the bridge crosses the bridge
twice with the same 5-tuple: once from the source to the router, and once
from the router to the destination. Bridge conntrack merges both crossings
into a single connection. Flow offload can only program one crossing's L2
rewrite into hardware flow tables (like Airoha PPE), keyed solely by 5-tuple.
As a result, packets of the other crossing match the same entry and receive
this crossing's L2 rewrite. Routed packets are sent back to the router until
their TTL expires, or the router is bypassed.

The second crossing always enters on another port than the first one, as it
enters where the first crossing left. Record the first ingress port of each
direction in a conntrack extension while the connection is not offloaded,
and mark the connection when a direction shows up on a second port. Such
connections are never offloaded. TCP is only offloaded once established, so
both crossings of the handshake have been recorded by then. UDP is offloaded
once a reply was seen, so the first packet made all its crossings.

If a connection was offloaded before its second crossing was seen, the
flowtable GC tears the flow down.

Connections without a record (first seen after confirmation, e.g. picked up
mid-stream) are not offloaded either.

Signed-off-by: Tao Gong <gongtao0607@gmail.com>
---
--- /dev/null
+++ b/include/net/netfilter/nf_conntrack_brxing.h
@@ -0,0 +1,35 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _NF_CONNTRACK_BRXING_H
+#define _NF_CONNTRACK_BRXING_H
+
+#include <linux/netfilter/nf_conntrack_tuple_common.h>
+#include <net/netfilter/nf_conntrack_extend.h>
+
+/* Bridge crossings of a connection, recorded before it is offloaded.
+ *
+ * A connection routed by a router reached through the bridge crosses the
+ * bridge twice with the same 5-tuple (A -> router, router -> B), and bridge
+ * conntrack merges both crossings into one ct. A flow can only describe one
+ * crossing, and PPE-style hardware keys entries by 5-tuple only, so the other
+ * crossing would get this crossing's L2 rewrite (loop or router bypass).
+ *
+ * The second crossing always enters on another port than the first one: it
+ * enters where the first crossing left. Record the first ingress port per
+ * direction; a different ingress port in the same direction marks the
+ * connection as crossing more than once. Such connections are not offloaded.
+ */
+struct nf_conn_brxing {
+	int	iif[IP_CT_DIR_MAX];
+	bool	multi;
+};
+
+static inline struct nf_conn_brxing *nf_conn_brxing_find(const struct nf_conn *ct)
+{
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	return nf_ct_ext_find(ct, NF_CT_EXT_BRXING);
+#else
+	return NULL;
+#endif
+}
+
+#endif /* _NF_CONNTRACK_BRXING_H */
--- a/include/net/netfilter/nf_conntrack_extend.h
+++ b/include/net/netfilter/nf_conntrack_extend.h
@@ -31,6 +31,9 @@ enum nf_ct_ext_id {
 #if IS_ENABLED(CONFIG_NET_ACT_CT)
 	NF_CT_EXT_ACT_CT,
 #endif
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	NF_CT_EXT_BRXING,
+#endif
 	NF_CT_EXT_NUM,
 };
 
--- a/net/netfilter/nf_conntrack_extend.c
+++ b/net/netfilter/nf_conntrack_extend.c
@@ -23,11 +23,15 @@
 #include <net/netfilter/nf_conntrack_labels.h>
 #include <net/netfilter/nf_conntrack_synproxy.h>
 #include <net/netfilter/nf_conntrack_act_ct.h>
+#include <net/netfilter/nf_conntrack_brxing.h>
 #include <net/netfilter/nf_nat.h>
 
 #define NF_CT_EXT_PREALLOC	128u /* conntrack events are on by default */
 
 static const u8 nf_ct_ext_type_len[NF_CT_EXT_NUM] = {
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+	[NF_CT_EXT_BRXING] = sizeof(struct nf_conn_brxing),
+#endif
 	[NF_CT_EXT_HELPER] = sizeof(struct nf_conn_help),
 #if IS_ENABLED(CONFIG_NF_NAT)
 	[NF_CT_EXT_NAT] = sizeof(struct nf_conn_nat),
@@ -57,7 +61,7 @@ static const u8 nf_ct_ext_type_len[NF_CT
 static __always_inline unsigned int total_extension_size(void)
 {
 	/* remember to add new extensions below */
-	BUILD_BUG_ON(NF_CT_EXT_NUM > 10);
+	BUILD_BUG_ON(NF_CT_EXT_NUM > 11);
 
 	return sizeof(struct nf_ct_ext) +
 	       sizeof(struct nf_conn_help)
@@ -84,6 +88,9 @@ static __always_inline unsigned int tota
 #if IS_ENABLED(CONFIG_NET_ACT_CT)
 		+ sizeof(struct nf_conn_act_ct_ext)
 #endif
+#if IS_ENABLED(CONFIG_NF_FLOW_TABLE)
+		+ sizeof(struct nf_conn_brxing)
+#endif
 	;
 }
 
--- a/net/netfilter/nf_flow_table_inet.c
+++ b/net/netfilter/nf_flow_table_inet.c
@@ -7,6 +7,7 @@
 #include <net/netfilter/nf_flow_table.h>
 #include <net/netfilter/nf_tables.h>
 #include <linux/if_vlan.h>
+#include <net/netfilter/nf_conntrack_brxing.h>
 
 static unsigned int
 nf_flow_offload_inet_hook(void *priv, struct sk_buff *skb,
@@ -75,6 +76,17 @@ static struct nf_flowtable_type flowtabl
 	.owner		= THIS_MODULE,
 };
 
+
+/* Tear down a bridge flow once its connection turned out to cross the
+ * bridge more than once, see struct nf_conn_brxing.
+ */
+static bool nf_flow_bridge_gc(const struct flow_offload *flow)
+{
+	const struct nf_conn_brxing *rec = nf_conn_brxing_find(flow->ct);
+
+	return rec && READ_ONCE(rec->multi);
+}
+
 static struct nf_flowtable_type flowtable_bridge;
 
 static struct nf_flowtable_type flowtable_ipv4 = {
@@ -100,6 +112,7 @@ static struct nf_flowtable_type flowtabl
 static int __init nf_flow_inet_module_init(void)
 {
 	flowtable_bridge = flowtable_inet; flowtable_bridge.family = NFPROTO_BRIDGE;
+	flowtable_bridge.gc = nf_flow_bridge_gc;
 
 	nft_register_flowtable_type(&flowtable_ipv4);
 	nft_register_flowtable_type(&flowtable_ipv6);
--- a/net/netfilter/nft_flow_offload.c
+++ b/net/netfilter/nft_flow_offload.c
@@ -16,6 +16,7 @@
 #include <net/netfilter/nf_conntrack_core.h>
 #include <net/netfilter/nf_conntrack_extend.h>
 #include <net/netfilter/nf_flow_table.h>
+#include <net/netfilter/nf_conntrack_brxing.h>
 
 struct nft_flow_offload {
 	struct nft_flowtable	*flowtable;
@@ -47,12 +48,82 @@ static void flow_offload_ct_tcp(struct n
 	spin_unlock_bh(&ct->lock);
 }
 
+
+/* Record the ingress port of each crossing of a bridged connection, see
+ * struct nf_conn_brxing. Runs for every packet that reaches the bridge
+ * forward chain, i.e. every packet not handled by the fast path.
+ */
+static void nft_flow_offload_bridge_record(const struct nft_pktinfo *pkt,
+					   struct nf_flowtable *flowtable,
+					   struct nf_conn *ct,
+					   enum ip_conntrack_info ctinfo)
+{
+	enum ip_conntrack_dir dir = CTINFO2DIR(ctinfo);
+	u8 proto = ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum;
+	struct nf_conn_brxing *rec;
+	int iif, old;
+
+	if ((proto != IPPROTO_TCP && proto != IPPROTO_UDP) || !nft_in(pkt))
+		return;
+
+	iif = nft_in(pkt)->ifindex;
+	rec = nf_conn_brxing_find(ct);
+	if (!rec) {
+		/* Extensions can only be added before confirmation. A
+		 * connection first seen here after that (e.g. picked up
+		 * mid-stream) has no record and is never offloaded.
+		 */
+		if (nf_ct_is_confirmed(ct))
+			return;
+		rec = nf_ct_ext_add(ct, NF_CT_EXT_BRXING, GFP_ATOMIC);
+		if (!rec)
+			return;
+	}
+
+	old = cmpxchg(&rec->iif[dir], 0, iif);
+	if (!old || old == iif || READ_ONCE(rec->multi))
+		return;
+
+	WRITE_ONCE(rec->multi, true);
+
+	/* Offloaded before the other crossing was seen (e.g. UDP with both
+	 * ends sending at once): let the flowtable GC tear it down now, see
+	 * nf_flow_bridge_gc().
+	 */
+	if (test_bit(IPS_OFFLOAD_BIT, &ct->status))
+		mod_delayed_work(system_power_efficient_wq,
+				 &flowtable->gc_work, 0);
+}
+
+/* Offload a bridged connection only if it crossed the bridge once. For UDP,
+ * wait for a reply: by then the first packet has made all its crossings.
+ * For TCP the handshake has, as offload requires an established connection.
+ */
+static bool nft_flow_offload_bridge_ok(const struct nf_conn *ct)
+{
+	const struct nf_conn_brxing *rec = nf_conn_brxing_find(ct);
+	u8 proto = ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum;
+
+	if (proto != IPPROTO_TCP && proto != IPPROTO_UDP)
+		return true;
+
+	if (!rec || READ_ONCE(rec->multi))
+		return false;
+
+	if (proto == IPPROTO_UDP &&
+	    !test_bit(IPS_SEEN_REPLY_BIT, &ct->status))
+		return false;
+
+	return true;
+}
+
 static void nft_flow_offload_eval(const struct nft_expr *expr,
 				  struct nft_regs *regs,
 				  const struct nft_pktinfo *pkt)
 {
 	struct nft_flow_offload *priv = nft_expr_priv(expr);
 	struct nf_flowtable *flowtable = &priv->flowtable->data;
+	bool routing = flowtable->type->family != NFPROTO_BRIDGE;
 	struct tcphdr _tcph, *tcph = NULL;
 	struct nf_flow_route route = {};
 	enum ip_conntrack_info ctinfo;
@@ -68,6 +139,9 @@ static void nft_flow_offload_eval(const
 	if (!ct)
 		goto out;
 
+	if (!routing)
+		nft_flow_offload_bridge_record(pkt, flowtable, ct, ctinfo);
+
 	switch (ct->tuplehash[IP_CT_DIR_ORIGINAL].tuple.dst.protonum) {
 	case IPPROTO_TCP:
 		tcph = skb_header_pointer(pkt->skb, nft_thoff(pkt),
@@ -102,6 +176,9 @@ static void nft_flow_offload_eval(const
 	if (!nf_ct_is_confirmed(ct))
 		goto out;
 
+	if (!routing && !nft_flow_offload_bridge_ok(ct))
+		goto out;
+
 	if (test_and_set_bit(IPS_OFFLOAD_BIT, &ct->status))
 		goto out;
 
