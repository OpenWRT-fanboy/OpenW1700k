mt76 calls the WED flow flush, idle and priority callbacks. The full
implementation depends on mtk_eth_soc changes that are not part of the
7.3 tree. Provide stubs for CONFIG_NET_MEDIATEK_SOC_WED disabled targets
so mt76 compiles without pulling in the driver changes.

--- a/include/linux/soc/mediatek/mtk_wed.h
+++ b/include/linux/soc/mediatek/mtk_wed.h
@@ -16,6 +16,7 @@
 
 struct mtk_wed_hw;
 struct mtk_wdma_desc;
+struct cfg80211_flow_info;
 
 enum mtk_wed_wo_cmd {
 	MTK_WED_WO_CMD_WED_CFG,
@@ -188,6 +189,9 @@ struct mtk_wed_device {
 					   struct mtk_wed_wo_rx_stats *stats);
 		int (*reset)(struct mtk_wed_device *wed);
 		void (*reset_complete)(struct mtk_wed_device *wed);
+		int (*flow_prio)(struct mtk_wed_device *wed, u16 wcid,
+				 const struct cfg80211_flow_info *info,
+				 int dscp, u8 *prio);
 	} wlan;
 #endif
 };
@@ -204,7 +208,7 @@ struct mtk_wed_ops {
 			  void *data, int len);
 	void (*detach)(struct mtk_wed_device *dev);
 	void (*ppe_check)(struct mtk_wed_device *dev, struct sk_buff *skb,
-			  u32 reason, u32 hash);
+			  u32 reason, u32 hash, u16 wcid);
 
 	void (*stop)(struct mtk_wed_device *dev);
 	void (*start)(struct mtk_wed_device *dev, u32 irq_mask);
@@ -225,6 +229,14 @@ struct mtk_wed_ops {
 				      void __iomem *regs);
 	int (*ind_rx_ring_setup)(struct mtk_wed_device *dev,
 				 void __iomem *regs);
+	void (*flow_flush)(struct mtk_wed_device *dev, u16 wcid,
+			   bool (*match)(const struct cfg80211_flow_info *info,
+					 bool rx, void *arg),
+			   void *arg);
+	int (*flow_idle)(struct mtk_wed_device *dev, u16 wcid,
+			 bool (*match)(const struct cfg80211_flow_info *info,
+				       bool rx, void *arg),
+			 void *arg);
 };
 
 extern const struct mtk_wed_ops __rcu *mtk_soc_wed_ops;
@@ -288,8 +300,8 @@ static inline bool mtk_wed_is_amsdu_supp
 	(_dev)->ops->irq_set_mask(_dev, _mask)
 #define mtk_wed_device_rx_ring_setup(_dev, _ring, _regs, _reset) \
 	(_dev)->ops->rx_ring_setup(_dev, _ring, _regs, _reset)
-#define mtk_wed_device_ppe_check(_dev, _skb, _reason, _hash) \
-	(_dev)->ops->ppe_check(_dev, _skb, _reason, _hash)
+#define mtk_wed_device_ppe_check(_dev, _skb, _reason, _hash, _wcid) \
+	((_dev)->ops->ppe_check(_dev, _skb, _reason, _hash, _wcid))
 #define mtk_wed_device_update_msg(_dev, _id, _msg, _len) \
 	(_dev)->ops->msg_update(_dev, _id, _msg, _len)
 #define mtk_wed_device_stop(_dev) (_dev)->ops->stop(_dev)
@@ -304,6 +316,10 @@ static inline bool mtk_wed_is_amsdu_supp
 	(_dev)->ops->msdu_pg_rx_ring_setup(_dev, _ring, _regs)
 #define mtk_wed_device_ind_rx_ring_setup(_dev, _regs) \
 	(_dev)->ops->ind_rx_ring_setup(_dev, _regs)
+#define mtk_wed_device_flow_flush(_dev, _wcid, _match, _arg) \
+	((_dev)->ops->flow_flush(_dev, _wcid, _match, _arg))
+#define mtk_wed_device_flow_idle(_dev, _wcid, _match, _arg) \
